<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".MainActivity">

    <!-- THE AURORE MK V HUD: Level 0 - Background Video -->
    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:translationZ="0dp" />

    <!-- Telemetry Panel -->
    <LinearLayout
        android:id="@+id/orientationPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#40000000"
        android:layout_margin="32dp"
        android:elevation="12dp"
        android:translationZ="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/linkStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AURORE MK V // STANDALONE"
            android:textColor="@color/accent_red"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/orientationData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YAW: ---.0°\nPITCH: ---.0°\nROLL: ---.0°"
            android:textColor="@color/accent_red"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="8dp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/systemStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="STATUS: NOMINAL"
        android:textColor="@color/accent_red"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_margin="32dp"
        android:translationZ="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Log Display -->
    <ScrollView
        android:id="@+id/logScrollView"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginBottom="8dp"
        android:background="#40000000"
        android:padding="8dp"
        android:translationZ="15dp"
        app:layout_constraintBottom_toTopOf="@+id/controlsLayout">

        <TextView
            android:id="@+id/logTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="--- System Log Initialized ---\n"
            android:textColor="@color/accent_green"
            android:textSize="10sp" />
    </ScrollView>

    <!-- IP Address Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/ipAddressInputLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        android:hint="Pi IP Address (e.g., 192.168.1.10)"
        android:textColorHint="#80FFFFFF"
        android:translationZ="15dp"
        app:boxStrokeColor="@color/accent_red"
        app:hintTextColor="@color/accent_red"
        app:layout_constraintBottom_toTopOf="@+id/controlsLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ipAddressEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:textColor="@color/white"
            android:imeOptions="actionDone" />

    </com.google.android.material.textfield.TextInputLayout>


    <!-- Bottom Controls -->
    <LinearLayout
        android:id="@+id/controlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center"
        android:translationZ="15dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/startButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="INITIALIZE"
            android:background="@drawable/btn_gradient"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginEnd="12dp"
            android:elevation="4dp"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="TERMINATE"
            android:background="@drawable/btn_gradient"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:elevation="4dp"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- Scanning Overlay (Aurore Style) -->
    <FrameLayout
        android:id="@+id/scanningOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:translationZ="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center"
            android:padding="32dp">

            <TextView
                android:id="@+id/asciiLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/accent_red"
                android:textSize="6sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:lineSpacingMultiplier="0.7" />

            <ProgressBar
                android:layout_width="120dp"
                android:layout_height="4dp"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent_red"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/scanningText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISCOVERING..."
                android:textColor="@color/accent_red"
                android:layout_marginTop="16dp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>